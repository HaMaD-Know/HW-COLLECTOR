{
  "name": "hotwheels-collector",
  "private": true,
  "version": "1.0.0",
  "description": "Hot Wheels Collector â€” an independent, local-first die-cast collection manager (Capacitor app for Android and iOS).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "postinstall": "node scripts/copy-wasm.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "android:open": "npx cap open android",
    "android:run": "npm run build && npx cap sync android && npx cap run android",
    "android:debug": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "assets:generate": "node scripts/make-icon.mjs && npx capacitor-assets generate --iconBackgroundColor \"#070b16\" --iconBackgroundColorDark \"#070b16\" --splashBackgroundColor \"#070b16\" --splashBackgroundColorDark \"#070b16\""
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "jeep-sqlite": "2.8.0",
    "lucide": "1.61.0",
    "sql.js": "1.11.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/sql.js": "1.4.11",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
