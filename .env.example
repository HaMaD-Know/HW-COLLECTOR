# ---------------------------------------------------------------------------
# Web/app build settings (Vite). Everything prefixed VITE_ is PUBLIC: it is
# bundled into the app and anyone can read it. NEVER put an AI provider key here.
# ---------------------------------------------------------------------------

# URL of YOUR deployed identification proxy (see backend/). Leave empty to ship
# the app without AI; users can also enter/override it in Settings.
VITE_AI_PROXY_URL=

# Optional low-value token the proxy can require (APP_CLIENT_TOKEN on the
# server). It is visible in the app bundle, so it only deters casual abuse —
# it is NOT a secret. Rate limiting on the server is the real control.
VITE_AI_CLIENT_TOKEN=
