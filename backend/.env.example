# Copy to backend/.env for local runs (never commit .env).
# In production set these as environment variables / secrets on your host.

# REQUIRED for AI identification. Server-side only.
ANTHROPIC_API_KEY=

# Optional
PORT=8787
AI_MODEL=claude-opus-5-5
# low | medium | high  (higher = slower, more thorough)
AI_EFFORT=medium
# Comma-separated origins allowed to call the proxy (app WebViews + dev server)
ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost,http://localhost:5173
# If set, the app must send the same value as X-Client-Token (VITE_AI_CLIENT_TOKEN).
# It ships inside the app, so treat it as a speed bump, not a secret.
APP_CLIENT_TOKEN=
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=60
MAX_CONCURRENT=4
REQUEST_TIMEOUT_MS=40000
# Set true only behind a reverse proxy/load balancer that sets X-Forwarded-For
TRUST_PROXY=false
